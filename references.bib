@ARTICLE{Hoffmann2021-pq,
  title        = {{SARS}-{CoV}-2 variants {B}.1.351 and {P}.1 escape from
                  neutralizing antibodies},
  author       = {Hoffmann, Markus and Arora, Prerna and Groß, Rüdiger and
                  Seidel, Alina and Hörnich, Bojan F and Hahn, Alexander S and
                  Krüger, Nadine and Graichen, Luise and Hofmann-Winkler, Heike
                  and Kempf, Amy and Winkler, Martin S and Schulz, Sebastian and
