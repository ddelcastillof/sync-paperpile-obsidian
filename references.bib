  journaltitle = {Health Sci. Rep.},
  publisher    = {Wiley},
  volume       = {3},
  issue        = {4},
  date         = {2020-12},
  abstract     = {AbstractBackground and AimsLongitudinal cohort studies
                  examining different generations can explain how health
                  problems can be transmitted through genetic and environmental
