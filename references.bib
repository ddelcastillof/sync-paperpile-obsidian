@ARTICLE{Kennedy-Shaffer2020-hs,
  title        = {Novel methods for the analysis of stepped wedge cluster
                  randomized trials},
  author       = {Kennedy-Shaffer, Lee and de Gruttola, Victor and Lipsitch,
