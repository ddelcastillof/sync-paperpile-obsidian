  journaltitle = {Blood},
  publisher    = {American Society of Hematology},
  volume       = {127},
  issue        = {20},
  pages        = {2375--2390},
  date         = {2016-05-19},
  abstract     = {A revision of the nearly 8-year-old World Health Organization
                  classification of the lymphoid neoplasms and the accompanying
                  monograph is being published. It reflects a consensus among
                  hematopathologists, geneticists, and clinicians regarding both
                  updates to current entities as well as the addition of a
