@ARTICLE{Naito2021-de,
  title        = {Brigatinib and lorlatinib: their effect on {ALK} inhibitors in
                  {NSCLC} focusing on resistant mutations and central nervous
                  system metastases},
  author       = {Naito, Tomoyuki and Shiraishi, Hideaki and Fujiwara, Yutaka},
