  author       = {Kim, Dong-Wan and Tiseo, Marcello and Ahn, Myung-Ju and
                  Reckamp, Karen L and Hansen, Karin Holmskov and Kim, Sang-We
                  and Huber, Rudolf M and West, Howard L and Groen, Harry J M
                  and Hochmair, Maximilian J and Leighl, Natasha B and
                  Gettinger, Scott N and Langer, Corey J and Paz-Ares Rodríguez,
                  Luis G and Smit, Egbert F and Kim, Edward S and Reichmann,
