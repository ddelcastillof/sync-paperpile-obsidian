@ARTICLE{VanderWeele2014-ws,
  title       = "Mediation Analysis with Time-Varying Exposures and Mediators",
  author      = "VanderWeele, Tyler J and Tchetgen, Eric Tchetgen",
  journal     = "Collection of Biostatistics Research Archive",
  institution = "Harvard University Department of Biostatistics",
  number      =  168,
  abstract    = "In this paper we consider mediation analysis when exposures and
                 mediators vary over time. We give non-parametric identification
                 results, discuss parametric implementation, and also provide a
                 weighting approach to direct and indirect effects based on
                 combining the results of two marginal structural models. We
                 also discuss how our results give rise to a causal
